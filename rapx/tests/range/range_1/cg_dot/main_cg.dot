        "_24" [label="_24", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_25" [label="_25", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_31" [label="_31", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
