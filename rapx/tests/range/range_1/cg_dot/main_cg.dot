        "op_28" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_29" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_30" [label="Essa", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_31" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_23" -> "_32";
    "op_26" -> "_16";
    "op_13" -> "_10";
    "op_20" -> "(_12.0: i32)";
    "op_24" -> "_33";
    "op_21" -> "_31";
    "op_31" -> "_0";
    "op_30" -> "_36";
    "op_1" -> "_20";
    "op_3" -> "_22";
    "op_6" -> "_24";
    "op_2" -> "_21";
    "op_12" -> "_9";
    "op_18" -> "_30";
    "op_22" -> "_2";
    "op_28" -> "_34";
    "op_29" -> "_35";
    "op_15" -> "_29";
    "op_10" -> "_26";
    "op_7" -> "_5";
    "op_5" -> "_4";
    "op_9" -> "_25";
    "op_17" -> "(_11.0: i32)";
    "op_0" -> "_1";
    "op_11" -> "_27";
    "op_14" -> "_28";
    "op_8" -> "_6";
    "op_25" -> "_7";
    "op_4" -> "_23";
    "op_19" -> "_12";
    "op_27" -> "(_16.0: i32)";
    "op_16" -> "_11";

    // Use Edges (var -> op)
    "(_11.0: i32)" -> "op_18";
    "_28" -> "op_17";
    "_28" -> "op_16";
    "_33" -> "op_3";
    "_1" -> "op_4";
    "_35" -> "op_1";
    "_29" -> "op_19";
    "_29" -> "op_20";
    "_5" -> "op_2";
