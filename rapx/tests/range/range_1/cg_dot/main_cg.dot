        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_34" [label="_34", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_23" [label="_23", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_2" [label="_2", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
