digraph ConstraintGraph {
    layout=neato;
    overlap=false;
    splines=true;
    sep="+1.0";
    rankdir=TB;
    ranksep=1.8;
    nodesep=0.8;
    edge [len=2.0];
    node [fontname="Fira Code"];

    // Variable Nodes
    subgraph cluster_vars {
        rank=same;
        "_1" [label="_1", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_18" [label="_18", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_17" [label="_17", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_4" [label="_4", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_3" [label="_3", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_14" [label="_14", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(_11.0: i32)" [label="(_11.0: i32)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_12" [label="_12", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_16" [label="_16", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_7" [label="_7", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_8" [label="_8", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_0" [label="_0", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "(_5.0: i32)" [label="(_5.0: i32)", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_11" [label="_11", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_22" [label="_22", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_9" [label="_9", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_24" [label="_24", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_5" [label="_5", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_15" [label="_15", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_20" [label="_20", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_6" [label="_6", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_10" [label="_10", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_21" [label="_21", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_23" [label="_23", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_19" [label="_19", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
        "_25" [label="_25", shape=ellipse, style=filled, fillcolor=lightblue, width=1.2, fixedsize=false];
    }

    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Binary(AddWithOverflow)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_2" [label="Binary(AddWithOverflow)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_3" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_4" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_5" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_6" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_7" [label="Binary(SubWithOverflow)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_8" [label="Binary(SubWithOverflow)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_9" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_10" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_11" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_12" [label="Essa", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_13" [label="Essa", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_14" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_15" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_16" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_17" [label="Essa", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_18" [label="Essa", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_19" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_20" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_21" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_22" [label="Φ (Phi)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_23" [label="Φ (Phi)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
    }

    // Definition Edges (op -> var)
    "op_4" -> "_6";
    "op_20" -> "_22";
    "op_11" -> "_15";
    "op_14" -> "_16";
    "op_17" -> "_20";
    "op_9" -> "_8";
    "op_21" -> "_23";
    "op_6" -> "_10";
    "op_15" -> "_7";
    "op_0" -> "_4";
    "op_1" -> "_5";
    "op_2" -> "(_5.0: i32)";
    "op_18" -> "_21";
    "op_13" -> "_19";
    "op_23" -> "_25";
    "op_10" -> "_14";
    "op_22" -> "_24";
    "op_5" -> "_9";
    "op_3" -> "_3";
    "op_12" -> "_18";
    "op_19" -> "_17";
    "op_7" -> "_11";
    "op_8" -> "(_11.0: i32)";
    "op_16" -> "_12";

    // Use Edges (var -> op)
    "_17" -> "op_20";
    "_12" -> "op_23";
    "_9" -> "op_8";
    "_9" -> "op_7";
    "(_5.0: i32)" -> "op_3";
    "_7" -> "op_22";
    "_21" -> "op_19";
    "(_11.0: i32)" -> "op_9";
    "_3" -> "op_17";
    "_3" -> "op_10";
    "_3" -> "op_12";
    "_3" -> "op_5";
    "_1" -> "op_0";
    "_1" -> "op_4";
    "_16" -> "op_15";
    "_4" -> "op_1";
    "_4" -> "op_2";
    "_6" -> "op_6";
    "_6" -> "op_11";
    "_6" -> "op_18";
    "_6" -> "op_13";
    "_22" -> "op_22";
    "_23" -> "op_23";
    "_18" -> "op_14";
    "_10" -> "op_8";
    "_10" -> "op_7";

    // Symbolic Bound Edges (var -> op)
    "_6" -> "op_12" [color=blue, style=dashed];
    "_6" -> "op_17" [color=blue, style=dashed];
    "_3" -> "op_18" [color=blue, style=dashed];
    "_3" -> "op_13" [color=blue, style=dashed];
}
