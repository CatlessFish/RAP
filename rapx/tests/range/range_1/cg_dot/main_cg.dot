    // Operation Nodes
    subgraph cluster_ops {
        rank=same;
        "op_0" [label="Use", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
        "op_1" [label="Φ (Phi)", shape=box, style=filled, fillcolor=lightgrey, width=1.5, fixedsize=false];
